# ==========================================
# RecoverAI Environment Configuration (Test Mode Only)
# ==========================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL / SQLite fallback for zero-setup local dev)
DATABASE_URL=sqlite+aiosqlite:///./recoverai.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/recoverai
SYNC_DATABASE_URL=sqlite:///./recoverai.db
# For PostgreSQL Sync: postgresql://postgres:postgres@localhost:5432/recoverai

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Razorpay Test Mode Credentials (NEVER USE LIVE KEYS)
RAZORPAY_KEY_ID=rzp_test_mockkey12345
RAZORPAY_KEY_SECRET=mocksecret12345
RAZORPAY_WEBHOOK_SECRET=mockwebhooksecret12345
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# AI / LLM Provider Configuration
LLM_PROVIDER=mock
# Options: mock, gemini, openai
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Fintech Policy Defaults
HIGH_VALUE_THRESHOLD=10000.00
MAX_RETRY_ATTEMPTS=2
MIN_AI_CONFIDENCE=0.70
MIN_RECOVERY_SCORE=15.00
CONTACT_COOLDOWN_MINUTES=60
DEMO_MODE=true
