            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRunRequest",
                "default": {
                  "scenario_name": "default_batch",
                  "batch_size": 10,
                  "enable_ai_agent": true,
                  "enable_policy_engine": true
                }
